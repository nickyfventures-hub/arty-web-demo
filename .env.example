# Copy to .env.local. Never commit .env.local.

# Optional. With a key set, onboarding is understood by Claude instead of by
# the built-in rules. Without one the route returns { available: false } and
# the client falls back silently, which is why this demo deploys with no
# configuration at all.
#
# Server side only. It is read in app/api/understand/route.ts and never
# reaches the browser.
ANTHROPIC_API_KEY=

# The SDK also accepts an auth token, if that is how you authenticate.
# hasConfiguredKey() checks for either, so `ant auth login` works too.
ANTHROPIC_AUTH_TOKEN=

# Supabase. Safe to commit these two: the publishable key identifies the
# project and grants nothing on its own, because every table is behind row
# level security. Defaults point at the shared development project.
NEXT_PUBLIC_SUPABASE_URL=https://xkeaykzxajjoclrmtqba.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_P_uhMu7RNcv3R4meuaqE0A_s3kCgttp

# NEVER put the service role key here, or anywhere in this repository. It
# bypasses every row level security policy. It belongs in Supabase's own
# secrets, used only from Edge Functions.
